<?xml version="1.0"?>
<robot name="phantomx_reactor" xmlns:xacro="http://www.ros.org/wiki/xacro">
	<!-- <xacro:include filename="$(find phantomx_reactor_arm_description)/urdf/phantomx_reactor_wrist_ros2_control.xacro" /> -->
	<!-- <xacro:include filename="$(find phantomx_reactor_arm_description)/urdf/gazebo.urdf.xacro"/> -->

	<xacro:property name="PI" value="3.141593"/>
	<xacro:property name="shoulder_yaw_joint_upper_limit" value="${PI}"/>
	<xacro:property name="shoulder_yaw_joint_lower_limit" value="-${PI}"/>
	
	<xacro:property name="shoulder_pitch_joint_upper_limit" value="${PI/2}"/>
	<xacro:property name="shoulder_pitch_joint_lower_limit" value="-${PI/2}"/>
	
	<xacro:property name="elbow_pitch_joint_upper_limit" value="${PI/2}"/>
	<xacro:property name="elbow_pitch_joint_lower_limit" value="-${PI/2}"/>
	
	<xacro:property name="wrist_pitch_upper_limit" value="1.9"/>
	<xacro:property name="wrist_pitch_lower_limit" value="-1.7"/>
	
	<xacro:property name="wrist_roll_upper_limit" value="${PI}"/>
	<xacro:property name="wrist_roll_lower_limit" value="-${PI}"/>
	
	<xacro:property name="gripper_joint_upper_limit" value="0.04"/>
	<xacro:property name="gripper_joint_lower_limit" value="0.01"/>
	
	<!-- <xacro:phantomx_ros2_control name="phantomx_ros2_control" /> -->
	<!-- <xacro:phantomx_ros2_control name="phantomx_ros2_control" /> -->


		<link name="base_footprint">
			<visual>
				<origin xyz="0 0 0" rpy="0 0 0" />
				<geometry>
					<box size="0.001 0.001 0.001" />
				</geometry>
			</visual>
			<collision>
				<geometry>
				<box size="0.01 0.01 0.01"/>
				</geometry>
			</collision>
		</link>
		
	    <!-- ARM BASE JOINT -->
		<joint name="base_joint" type="fixed">
			<insert_block name="origin" />
			<parent link="base_footprint" />
			<child link="base_link" />
			<dynamics damping="0.7"/>
		</joint>
		
		<link name="base_link">
			<visual>
			  <origin xyz="0 0 0" rpy="0 0 0" />
			  <geometry>
				<mesh filename="file://$(find phantomx_reactor_arm_description)/meshes/base_link.STL" /> 
				<!-- <mesh filename="package://phantomx_reactor_arm_description/meshes/base_link.STL" /> -->
			  </geometry>
			  <material name="grey">
				<color rgba="0.25098 0.25098 0.25098 1" />
			  </material>
			</visual>
			<collision>
			  <origin xyz="0 0 0" rpy="0 0 0" />
			  <geometry>
				<mesh filename="file://$(find phantomx_reactor_arm_description)/meshes/base_link_hull.stl" />
				<!-- <mesh filename="package://phantomx_reactor_arm_description/meshes/base_link_hull.stl" /> -->
			  </geometry>
			</collision>
		</link>
		
		<!-- SHOULDER YAW -->
		<joint name="shoulder_yaw_joint" type="revolute">
			<origin xyz="0 0 0.081" rpy="0 0 0" />
			<parent link="base_link" />
			<child link="shoulder_link" />
			<axis xyz="0 0 1" />
			<limit effort="1.5" velocity="6.178465545" lower="${shoulder_yaw_joint_lower_limit}" upper="${shoulder_yaw_joint_upper_limit}" />
			<dynamics damping="0.7"/>
		</joint>
		<link name="shoulder_link">
			<visual>
			  <origin xyz="0 0 0" rpy="0 0 0" />
			  <geometry>
				<mesh   filename="file://$(find phantomx_reactor_arm_description)/meshes/shoulder_link.STL" />
				<!-- <mesh   filename="package://phantomx_reactor_arm_description/meshes/shoulder_link.STL" /> -->
			  </geometry>
			  <material
				name="">
				<color   rgba="0.25098 0.25098 0.25098 1" />
			  </material>
			</visual>
			<collision>
			  <origin xyz="0 0 0" rpy="0 0 0" />
			  <geometry>
				<!-- <mesh   filename="package://phantomx_reactor_arm_description/meshes/shoulder_link_hull.stl" /> -->
				<mesh   filename="file://$(find phantomx_reactor_arm_description)/meshes/shoulder_link_hull.stl" />
			  </geometry>
			</collision>
		</link>
		
		<!-- SHOULDER PITCHS -->

		<!-- SHOULDER_Dyna_Left -->
		<joint name="shoulder_pitch_joint" type="revolute">
			<origin xyz="0 0 0.0265" rpy="${PI/2} 0 0" />
			<parent link="shoulder_link" />
			<child link="bicep_link" />
			<axis xyz="0 0 -1" />
			<limit effort="3.0" velocity="6.178465545" lower="${shoulder_pitch_joint_lower_limit}" upper="${shoulder_pitch_joint_upper_limit}" />
			<dynamics damping="0.7"/>
		</joint>	

		<!-- SHOULDER_Dyna_Right -->
		<joint name="shoulder_pitch_joint_right" type="revolute">
			<origin xyz="0 0 0.0265" rpy="${PI/2} 0 ${PI}" />
			<parent link="shoulder_link" />
			<child link="aux_link" />
			<axis xyz="0 0 1" />
			<limit effort="3.0" velocity="6.178465545" lower="${shoulder_pitch_joint_lower_limit}" upper="${shoulder_pitch_joint_upper_limit}" />
			<dynamics damping="0.7"/>
			<mimic joint="shoulder_pitch_joint" multiplier="1.0"/> 
		</joint>
		
		<!-- Auxiliar Link to make the move off 2 motors assign 2 one link -->
		<link name="aux_link">
			<visual>
				<origin xyz="0 0 0" rpy="0 0 0" />
				<material name="grey"> 
					<color rgba="0.25098 0.25098 0.25098 1" />
				</material> 
			</visual> 
			<collision>
				<origin xyz="0 0 0" rpy="0 0 0" />
			</collision>
			<inertial>
			  <origin xyz="-0.079312 0.00175 0.0073486" rpy="-${PI/2} 0 -${PI/2}" />
			  <mass value="0.29331" />
			  <inertia  ixx="0.00040741" ixy="-1.1578E-09" ixz="-0.00014106"
						iyy="0.0010604" iyz="1.1578E-09"
						izz="0.0012838" />
			</inertial>
		</link>

		<link name="bicep_link">
			<visual>
			  <origin xyz="0 0 0" rpy="-${PI/2} 0 -${PI/2}" />
			  <geometry>
				<mesh filename="file://$(find phantomx_reactor_arm_description)/meshes/bicep_link.STL" />
				<mesh filename="package://phantomx_reactor_arm_description/meshes/bicep_link.stl" />
			  </geometry>
			  <material name="grey">
				<color rgba="0.25098 0.25098 0.25098 1" />
			  </material>
			</visual>
			<collision>
			  <origin xyz="0 0 0" rpy="-${PI/2} 0 -${PI/2}" />
			  <geometry>
				<mesh filename="file://$(find phantomx_reactor_arm_description)/meshes/bicep_link_hull.stl" />
				<!-- <mesh filename="package://phantomx_reactor_arm_description/meshes/bicep_link_hull.stl" /> -->
			  </geometry>
			</collision>
		</link>	

	    <!-- ELBOW PITCHS-->

	    <!-- ELBOW_Left_PITCHS-->
		<joint name="elbow_pitch_joint" type="revolute"> 
			<origin xyz="0.0385 0.1445 0" rpy="-${PI/2} 0 0" />
			<parent link="bicep_link" /> 
			<child link="forearm_link" /> 
			<axis xyz="0 1 0" /> <limit effort="3.0" velocity="6.178465545" lower="${elbow_pitch_joint_lower_limit}" upper="${elbow_pitch_joint_upper_limit}" />
		</joint>
		<!-- ELBOW_Right_PITCHS -->
		<joint name="elbow_pitch_joint_right" type="revolute"> 
			<origin xyz="0.0385 0.1445 0" rpy="-${PI/2} 0 ${PI}" />
			<parent link="bicep_link" /> 
			<child link="aux2_link" /> 
			<axis xyz="0 1 0" /> <limit effort="3.0" velocity="6.178465545" lower="${elbow_pitch_joint_lower_limit}" upper="${elbow_pitch_joint_upper_limit}" />
			<dynamics damping="0.7"/>
			<mimic joint="elbow_pitch_joint" multiplier="1.0"/> 
		</joint>

		<!-- Auxiliar Link to make the move off 2 mottors assign 2 one link -->
		<link name="aux2_link">
			<visual>
				<origin xyz="0 0 0" rpy="0 0 0" />
				<material name="grey"> 
					<color rgba="0.25098 0.25098 0.25098 1" />
				</material> 
			</visual> 
			<collision>
				<origin xyz="0 0 0" rpy="0 0 0" />
			</collision>
			<inertial>
			  <origin xyz="-0.079312 0.00175 0.0073486" rpy="-${PI/2} 0 -${PI/2}" />
			  <mass value="0.29331" />
			  <inertia  ixx="0.00040741" ixy="-1.1578E-09" ixz="-0.00014106"
						iyy="0.0010604" iyz="1.1578E-09"
						izz="0.0012838" />
			</inertial>
		</link>
		

		<link name="forearm_link"> 
			<visual>
				<origin xyz="0 0 0" rpy="0 0 0" />
				<geometry> 
					<mesh filename="file://$(find phantomx_reactor_arm_description)/meshes/forearm_link.stl" />
					<mesh filename="package://phantomx_reactor_arm_description/meshes/forearm_link.stl" />
				</geometry>
				<material name="grey"> 
					<color rgba="0.25098 0.25098 0.25098 1" />
				</material> 
			</visual> 
			<collision>
				<origin xyz="0 0 0" rpy="0 0 0" />
				<geometry> 
					<mesh filename="file://$(find phantomx_reactor_arm_description)/meshes/forearm_link_hull.stl" />
					<!-- <mesh filename="package://phantomx_reactor_arm_description/meshes/forearm_link_hull.stl" /> -->
				</geometry>
			</collision>
		</link>
		
		<!-- WRIST PITCH -->
		<joint name="wrist_pitch_joint" type="revolute"> 
			<origin xyz="0.1535 0 0"   rpy="0 0 0" /> 
			<parent link="forearm_link" />
			<child link="wrist_1_link" /> 
			<axis xyz="0 1 0" /> 
			<limit effort="1.5" velocity="6.178465545" lower="${wrist_pitch_lower_limit}" upper="${wrist_pitch_upper_limit}"/> 
			<dynamics damping="0.7"/>
		</joint> 
		<link name="wrist_1_link"> 
			<visual>   
				<origin xyz="0 0 0" rpy="0 0 0" />   
				<geometry> 
					<mesh filename="file://$(find phantomx_reactor_arm_description)/meshes/wrist_1.stl" />
					<mesh filename="package://phantomx_reactor_arm_description/meshes/wrist_1.stl" />
				</geometry>   
				<material name="grey">
					<color rgba="0.25098 0.25098 0.25098 1" />   
				</material> 
			</visual> 
			<collision>
				<origin xyz="0 0 0" rpy="0 0 0" />
				<geometry> 
					<mesh filename="file://$(find phantomx_reactor_arm_description)/meshes/wrist_1_hull.stl" />
					<!-- <mesh filename="package://phantomx_reactor_arm_description/meshes/wrist_1_hull.stl" /> -->
				</geometry>
			</collision>
		</link> 
	  
		<!-- WRIST ROLL -->
		<joint name="wrist_roll_joint" type="revolute"> 
			<origin xyz="0.071 0.00175 0" rpy="0 0 0" /> 
			<parent link="wrist_1_link" /> 
			<child link="wrist_2_link" /> 
			<axis xyz="1 0 0" /> 
			<limit effort="1.5" velocity="6.178465545" lower="${wrist_roll_lower_limit}" upper="${wrist_roll_upper_limit}" /> 
			<dynamics damping="0.7"/>
		</joint> 
		<link name="wrist_2_link"> 
			<visual>
				<origin xyz="0 0 0" rpy="0 0 0" />
				<geometry> 
					<mesh filename="file://$(find phantomx_reactor_arm_description)/meshes/wrist_2.stl" />
					<mesh filename="package://phantomx_reactor_arm_description/meshes/wrist_2.stl" />
				</geometry>
				<material name="grey"> 
					<color rgba="0.25098 0.25098 0.25098 1" />
				</material>
			</visual>
			<collision>
				<origin xyz="0 0 0" rpy="0 0 0" />
				<geometry> 
					<mesh filename="file://$(find phantomx_reactor_arm_description)/meshes/wrist_2_hull.stl" />
					<!-- <mesh filename="package://phantomx_reactor_arm_description/meshes/wrist_2_hull.stl" /> -->
				</geometry>
			</collision>
		</link>
		
		<!-- GRIPPER -->
		<joint name="gripper_guide_joint" type="fixed"> 
			<origin xyz="0.05 0.00 0"   rpy="0 0 0" /> 
			<parent link="wrist_2_link" /> 
			<child link="gripper_guide_link" /> 
			<axis xyz="0 0 1" /> 
			<limit effort="1.5" velocity="6.178465545" lower="0" upper="1.57"/> 
			<dynamics damping="0.7"/>
		</joint> 

		<link name="gripper_guide_link"> 
			<inertial>
				<origin xyz="0.0091884 -7.3309E-13 -3.4513E-05" rpy="0 0 0" />
				<mass value="0.02487" />
				<inertia ixx="1.5997E-05" ixy="1.6551E-16" ixz="8.3911E-09" iyy="7.3918E-06" iyz="-2.7145E-16" izz="1.5931E-05" /> 
			</inertial> 
			<visual>   
				<origin xyz="0 0 0" rpy="1.57 3.14 1.57" />   
				<geometry> 
					<mesh filename="file://$(find phantomx_reactor_arm_description)/meshes/Guide_Rail_Fixed_Centered.stl" scale="0.01 0.01 0.01" />
					<mesh filename="package://phantomx_reactor_arm_description/meshes/Guide_Rail_Fixed_Centered.stl" scale="0.01 0.01 0.01" />
				</geometry>
				<material name="grey"> 
					<color rgba="0.25098 0.25098 0.25098 1" />
				</material> 
			</visual>
			<collision>
				<origin xyz="0 0 0" rpy="1.57 3.14 1.57" />
				<geometry> 
					<mesh filename="file://$(find phantomx_reactor_arm_description)/meshes/Guide_Rail_Fixed_Centered.stl" scale="0.01 0.01 0.01" /> 
					<!-- <mesh filename="package://phantomx_reactor_arm_description/meshes/Guide_Rail_Fixed_Centered.stl" scale="0.01 0.01 0.01" />  -->
				</geometry>
			</collision> 
		</link> 
		<!-- <joint name="gripper_revolute_joint" type="revolute">
			 <origin xyz = "0 0 0" rpy="0 ${PI/2} 0" />
			 <parent link="gripper_guide_link" />
			 <child link="gripper_aux_link" />
			 <axis xyz="0 0 1" />
			 <limit lower="-${PI}" upper="${PI}" effort="0" velocity="0.5" />
        </joint>
        <link name="gripper_aux_link"> 
		</link> -->
      
		<joint name="gripper_right_joint" type="prismatic"> 
			<origin xyz="0.0202 0 0"   rpy="0 0 0" /> 
			<parent link="gripper_guide_link" /> 
			<child link="gripper_right_link" /> 
			<axis xyz="0 1 0" /> 
			<limit effort="1.5" velocity="6.178465545" lower="${gripper_joint_lower_limit}" upper="${gripper_joint_upper_limit}" /> 
			<dynamics damping="0.7"/>
		</joint> 

		<link name="gripper_right_link">
			<inertial>
				<origin xyz="0.0091884 -7.3309E-13 -3.4513E-05" rpy="0 0 0" />
				<mass value="0.02487" />
				<inertia ixx="1.5997E-05" ixy="1.6551E-16" ixz="8.3911E-09" iyy="7.3918E-06" iyz="-2.7145E-16" izz="1.5931E-05" /> 
			</inertial> 
			<visual>  
				<origin xyz="0 0.010 0" rpy="-1.57 -1.57 0" />   
				<geometry> 
					<mesh filename="file://$(find phantomx_reactor_arm_description)/meshes/Gripper_Hand_Fixed_Centered.stl" scale="0.01 0.01 0.01" />   
					<!-- <mesh filename="package://phantomx_reactor_arm_description/meshes/Gripper_Hand_Fixed_Centered.stl" scale="0.01 0.01 0.01" />    -->
				</geometry>  
				<material name="grey"> 
					<color rgba="0.25098 0.25098 0.25098 1" />   
				</material> 
			</visual> 
			<collision>   
				<origin xyz="0 0.010 0" rpy="-1.57 -1.57 0" />   
				<geometry> 
					<mesh filename="file://$(find phantomx_reactor_arm_description)/meshes/Gripper_Hand_Fixed_Centered.stl" scale="0.01 0.01 0.01" />   
					<!-- <mesh filename="package://phantomx_reactor_arm_description/meshes/Gripper_Hand_Fixed_Centered.stl" scale="0.01 0.01 0.01" />    -->
				</geometry> 
			</collision> 
		</link>

		<joint name="gripper_left_joint" type="prismatic"> 
			<origin xyz="0.0202 0 0" rpy="0 0 0" /> 
			<parent link="gripper_guide_link" /> 
			<child link="gripper_left_link" /> 
			<axis xyz="0 1 0" /> 
			<limit effort="1.5" velocity="6.178465545"  lower="-1.9" upper="0" /> 
			<mimic joint="gripper_right_joint" multiplier="-1.0"/> 
			<dynamics damping="0.7"/>
		</joint> 
		<link name="gripper_left_link">
			<inertial>
				<origin xyz="0.0091884 -7.3309E-13 -3.4513E-05" rpy="0 0 0" />
				<mass value="0.02487" />
				<inertia ixx="1.5997E-05" ixy="1.6551E-16" ixz="8.3911E-09" iyy="7.3918E-06" iyz="-2.7145E-16" izz="1.5931E-05" /> 
			</inertial> 
			<visual>   
				<origin xyz="0 -0.010 0" rpy="1.57 1.57 0" />  
				<geometry> 
					<mesh filename="file://$(find phantomx_reactor_arm_description)/meshes/Gripper_Hand_Fixed_Centered.stl" scale="0.01 0.01 0.01" />   
					<mesh filename="package://phantomx_reactor_arm_description/meshes/Gripper_Hand_Fixed_Centered.stl" scale="0.01 0.01 0.01" />   
				</geometry>  
				<material name="grey"> 
					<color rgba="0.25098 0.25098 0.25098 1" />   
				</material> 
			</visual> 
			<collision> 
				<origin xyz="0 -0.010 0" rpy="1.57 1.57 0" />   
				<geometry> 
					<mesh filename="file://$(find phantomx_reactor_arm_description)/meshes/Gripper_Hand_Fixed_Centered.stl" scale="0.01 0.01 0.01" />   
					<!-- <mesh filename="package://phantomx_reactor_arm_description/meshes/Gripper_Hand_Fixed_Centered.stl" scale="0.01 0.01 0.01" />    -->
				</geometry> 
			</collision> 
		</link> 

	<!-- </xacro:macro> -->
	<!-- <xacro:phantomx_ros2_control name="phantomx_ros2_control" /> -->

</robot>
