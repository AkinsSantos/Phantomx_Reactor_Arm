<?xml version="1.0"?>
<robot name="phantomx_reactor_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

	<!-- Import URDF xacro model -->
	<xacro:include
		filename="$(find phantomx_reactor_arm_description)/urdf/phantomx_test.urdf.xacro" />

	<link name="base_footprint">
		<visual>
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<box size="0.001 0.001 0.001" />
			</geometry>
		</visual>
		<collision>
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<box size="0.0001 0.0001 0.0001" />
			</geometry>
		</collision>
	</link>

	<xacro:phantomx_reactor_wrist parent="base_footprint">
		<origin xyz="0 0 0" rpy="0 0 0" />
	</xacro:phantomx_reactor_wrist>

</robot>