<?xml version="1.0"?>
<package format="3">
  <name>phantomx_reactor_arm_description</name>
  <version>0.1.4</version>
  <description>The phantomx_reactor_arm_description package</description>

  <author email="rguzman@robotnik.es">Roberto Guzmán</author>
  <maintainer email="rguzman@robotnik.es">Roberto Guzmán</maintainer>
  <maintainer email="victorcarvesk@gmail.com">João Vítor Carvalho</maintainer>

  <license>BSD</license>

  <!-- <url type="website">http://wiki.ros.org/phantomx_reactor_arm_description</url> -->
  <url type="repository">https://github.com/TheMag0/Phantomx_Reactor_Arm</url>
  <url type="bugtracker">https://github.com/RobotnikAutomation/phantomx_reactor_arm/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>urdf</depend>
  <depend>xacro</depend>
  <depend>dynamixel_sdk</depend>
  <depend>controller_manager</depend>


  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>ros2_gz_control</exec_depend>
  <exec_depend>ign_ros2_control</exec_depend>
  <exec_depend>hardware_interface</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- <exec_depend>xacro</exec_depend> -->

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rclcpp</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <!-- ros2_control -->
  <exec_depend>ackermann_steering_controller</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>effort_controllers</exec_depend>
  <exec_depend>imu_sensor_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>mecanum_drive_controller</exec_depend>
  <exec_depend>ros2controlcli</exec_depend>
  <exec_depend>tricycle_controller</exec_depend>
  <exec_depend>velocity_controllers</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

