<?xml version="1.0"?>
<robot name="phantomx_reactor_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

	<!-- Import URDF xacro model -->
	<xacro:include
		filename="$(find phantomx_reactor_arm_description)/urdf/phantomx_reactor_wrist.urdf.xacro" />

	<link name="base_footprint">
		<inertial>
			<origin xyz="-3.9657E-09 2.0144E-09 0.04262" rpy="0 0 0" />
			<mass value="0.33742" />
			<inertia 	ixx="0.0011303" ixy="2.3398E-15" ixz="5.3844E-11" 
					iyy="0.0011303" iyz="-2.735E-11" 
					izz="0.0016747" />
		</inertial>
		<visual>
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<box size="0.001 0.001 0.001" />
			</geometry>
		</visual>
		<collision>
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<box size="0.0001 0.0001 0.0001" />
			</geometry>
		</collision>
	</link>

	<xacro:phantomx_reactor_wrist parent="base_footprint">
		<origin xyz="0 0 0" rpy="0 0 0" />
	</xacro:phantomx_reactor_wrist>

</robot>